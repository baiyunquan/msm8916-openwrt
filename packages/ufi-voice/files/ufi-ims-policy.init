#!/bin/sh /etc/rc.common
START=62
STOP=10
USE_PROCD=1
start_service() {
    [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'thwc,ufi103s-v05' ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 -u /usr/sbin/ufi-ims-policy --watch
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
