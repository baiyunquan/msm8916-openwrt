#!/bin/sh
#
# Create the "ims" 3GPP WDS profile as early as possible after the modem
# appears, and flag it IMCN=1 + PCSCF-via-PCO=1.
#
# Why this exists: the modem's IMS stack reads the WDS profile table once per
# boot, and the carrier MCFG declares the "ims" PDN as Override_Type:API, so no
# profile is ever materialised for it.  A profile created after the IMS stack
# has read the table is invisible and IMS never registers.
# See Docs/Modem Stability/220_VOLTE_ENABLEMENT_SOP.md, F29/F30 and S23.
#
# Nothing here restarts anything -- it only has to win the race against the
# modem's IMS bring-up.

DEV=/dev/wwan0qmi0
READY=/var/run/ims-profile-ready

log() { logger -t ims-profile "$*"; }

rm -f "$READY"

i=0
while [ ! -e "$DEV" ] && [ $i -lt 600 ]; do
	usleep 100000
	i=$((i + 1))
done

if [ ! -e "$DEV" ]; then
	log "no $DEV after 60 s, giving up"
	touch "$READY"
	exit 1
fi

# Keep the two tested IMS enable flags in EFS on UFI103S v05. Other boards can
# use different modem profiles, so leave their EFS configuration untouched.
# These NV items persist and the command is a no-op once both already equal 01.
if [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "thwc,ufi103s-v05" ]; then
	if ! /usr/sbin/volte-setup apply-ims-flags >/dev/null 2>&1; then
		log "could not verify UFI103S IMS enable flags through DIAG"
	fi
fi

# Existing profiles may lose IMCN/PCO flags after a modem reset. Always check
# those flags, including on the existing-profile path.
idx=$(qmicli -d "$DEV" --device-open-proxy --wds-get-profile-list=3gpp 2>/dev/null |
	awk '/^[[:space:]]*\[[0-9]+\]/ { idx=$1; gsub(/[][]/, "", idx) }
	     /APN: '\''ims'\''/ { print idx; exit }')

# The QMI service can NAK the first few requests while the modem finishes
# booting, so retry until it answers.
j=0
while [ -z "$idx" ] && [ $j -lt 100 ]; do
	idx=$(qmicli -d "$DEV" --device-open-proxy \
		--wds-create-profile=3gpp,apn=ims,pdp-type=IPV4V6 2>/dev/null |
		sed -n "s/.*Profile index: '\([0-9][0-9]*\)'.*/\1/p")
	[ -n "$idx" ] && break
	usleep 100000
	j=$((j + 1))
done

if [ -z "$idx" ]; then
	log "could not create the ims profile"
	touch "$READY"
	exit 1
fi

if ! /usr/sbin/ufi-ims-policy --profile "$idx"; then
	log "ims profile $idx: could not verify IMCN/PCO flags"
	touch "$READY"
	exit 1
fi

log "ims profile $idx ready, IMCN and PCSCF-via-PCO verified"
touch "$READY"
exit 0
